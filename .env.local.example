# Supabase credentials for the MONTY dashboard.
# Copy this file to .env.local and fill in the two values from your Supabase
# project:  Project Settings -> API  ->  "Project URL" and "anon public" key.
# Restart `npm run dev` after changing these.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
